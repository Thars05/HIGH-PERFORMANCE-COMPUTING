#include<stdio.h>
#include<omp.h>
int main(){
      int i,j;
      int m,n;
      int arr[20][20],res[20][20];
      printf("enter no of rows:");
      scanf("%d",&m);
      printf("Enter no of columns:");
      scanf("%d",&n);
      if(m!=n){
         printf("Square matrix only");
         }
      for(i=0;i<m;i++){
         for(j=0;j<n;j++){
            scanf("%d",&arr[i][j]);
         }
      }
     #pragma omp parallel for
      for(i=0;i<m;i++){
         for(j=0;j<n;j++){
            res[i][n-j-1]=arr[i][j];
            }
         }
      printf("RESULT\n");
      for(i=0;i<m;i++){
         for(j=0;j<n;j++){
            printf("%d " ,res[i][j]);
            }
         printf("\n");
         }
      return 0;
      }
