
#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>
#include <unistd.h>
#include <time.h>

int main()
{
    int m,n,p,i,j,k;

    printf("Enter rows of A, cols of A (rows of B), and cols of B: ");
    scanf("%d %d %d", &m, &n, &p);

    size_t sizeA = m * n * sizeof(int);
    size_t sizeB = n * p * sizeof(int);
    size_t sizeC = m * p * sizeof(int);

    int shmA = shmget(IPC_PRIVATE, sizeA, IPC_CREAT | 0666);
    int shmB = shmget(IPC_PRIVATE, sizeB, IPC_CREAT | 0666);
    int shmC = shmget(IPC_PRIVATE, sizeC, IPC_CREAT | 0666);

    int *A = (int *)shmat(shmA, NULL, 0);
    int *B = (int *)shmat(shmB, NULL, 0);
    int *C = (int *)shmat(shmC, NULL, 0);

    printf("\nEnter Matrix A:\n");
    for(i=0;i<m;i++)
        for(j=0;j<n;j++)
            scanf("%d",&A[i*n + j]);

    printf("\nEnter Matrix B:\n");
    for(i=0;i<n;i++)
        for(j=0;j<p;j++)
            scanf("%d",&B[i*p + j]);

    struct timespec start, end;
    clock_gettime(CLOCK_MONOTONIC, &start);


    for(i=0;i<m;i++){
        pid_t pid = fork();
        if(pid == 0){
            for(j=0;j<p;j++){
                int sum = 0;
                for(k=0;k<n;k++){
                    sum += A[i*n + k] * B[k*p + j];
                }
                C[i*p + j] = sum;
            }
            exit(0);
        }
    }

    for(i=0;i<m;i++)
        wait(NULL);

    clock_gettime(CLOCK_MONOTONIC, &end);

    double time_taken = (end.tv_sec - start.tv_sec)
                      + (end.tv_nsec - start.tv_nsec)/1e9;

    printf("\nResult Matrix (Parallel using fork):\n");
    for(i=0;i<m;i++){
        for(j=0;j<p;j++)
            printf("%5d ",C[i*p + j]);
        printf("\n");
    }

    printf("\nParallel Execution Time = %.9f seconds\n", time_taken);

    shmdt(A); shmdt(B); shmdt(C);
    shmctl(shmA, IPC_RMID, NULL);
    shmctl(shmB, IPC_RMID, NULL);
    shmctl(shmC, IPC_RMID, NULL);

    return 0;
}
