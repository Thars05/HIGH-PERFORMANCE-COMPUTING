#include<stdio.h>
#include<stdlib.h>
#include<pthread.h>
#define MAX 10
int A[MAX][MAX],B[MAX][MAX],SUM[MAX][MAX],PRO[MAX][MAX];
int n,i,j,k;
void* mat_add(void*arg){

   for(i=0;i<n;i++){
      for(j=0;j<n;j++){
         SUM[i][j]=A[i][j]+B[i][j];
      }
   }
   printf("Addition thread calculation completed\n");
   return NULL;
}
void* mat_mul(void*arg){
   for(i=0;i<n;i++){
      for(j=0;j<n;j++){
         PRO[i][j]=0;
         for(k=0;k<n;k++){
            PRO[i][j]+=A[i][k]*B[k][j];
         }
      }
   }
   printf("Multiplication thread calculation completed\n");
   return NULL;
}
int main(){
   printf("-----------------Addition and Multiplication of matrix using Pthreads--------------------------\n");
   pthread_t thread1,thread2;
   printf("Enter size of matrix(NxN):");
   scanf("%d",&n);
   if(n>MAX){
      printf("Error:Max size");
      return 1;
   }
   printf("Enter matrixA elements:\n");
   for(i=0;i<n;i++){
      for(j=0;j<n;j++){
         scanf("%d",&A[i][j]);
      }
      printf("\n");
   }
   printf("Enter matrixB elements:\n");
   for(i=0;i<n;i++){
      for(j=0;j<n;j++){
         scanf("%d",&B[i][j]);
      }
      printf("\n");
   }
   pthread_create(&thread1,NULL,mat_add,NULL);
   pthread_create(&thread2,NULL,mat_mul,NULL);
   pthread_join(thread1,NULL);
   pthread_join(thread2,NULL);
   printf("Result of matrix addition\n");
   for(i=0;i<n;i++){
      for(j=0;j<n;j++){
         printf("%d\t",SUM[i][j]);
      }
      printf("\n");
   }
   printf("Result of matrix multiplication:\n");
   for(i=0;i<n;i++){
      for(j=0;j<n;j++){
         printf("%d\t",PRO[i][j]);
      }
      printf("\n");
   }
   return 0;
   free(&thread1);
   free(&thread2);

}
