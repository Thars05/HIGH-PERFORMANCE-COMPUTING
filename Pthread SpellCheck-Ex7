#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#define MAX 50
#define WORD_SIZE 50
#define RESULT_SIZE 100
#define NUM_THREADS 3
#define BUFFER_SIZE 10
typedef struct {
    char word[WORD_SIZE];
    int index;
} WordItem;
WordItem buffer[BUFFER_SIZE];
int in = 0, out = 0, count = 0;
char result_buffer[MAX][RESULT_SIZE];
int total_words = 0;
int dict_size = 0;
char dictionary[MAX][WORD_SIZE];
int done = 0,i;
pthread_mutex_t mutex;
pthread_cond_t full, empty;
int check_word(char *word) {
    for ( i = 0; i < dict_size; i++) {
        if (strcmp(word, dictionary[i]) == 0) return 1;
    }
    return 0;
}
void *spell_check(void *arg) {
    while (1) {
        WordItem item;
        pthread_mutex_lock(&mutex);
        while (count == 0 && !done) {
            pthread_cond_wait(&full, &mutex);
        }
        if (count == 0 && done) {
            pthread_mutex_unlock(&mutex);
            return NULL;
        }
        item = buffer[out];
        out = (out + 1) % BUFFER_SIZE;
        count--;
        pthread_cond_signal(&empty);
        pthread_mutex_unlock(&mutex);
        int result = check_word(item.word);
        pthread_mutex_lock(&mutex);
        if (result == 1)
            sprintf(result_buffer[item.index], "%s -> Correct", item.word);
        else
            sprintf(result_buffer[item.index], "%s -> Incorrect", item.word);
        pthread_mutex_unlock(&mutex);
    }
    return NULL;
}

int main() {
    int i;
    pthread_t threads[NUM_THREADS];
    FILE *dict_file = fopen("dictionary.txt", "r");
    if (!dict_file) {
        perror("Dictionary error");
        return 1;
    }
    while (dict_size < MAX && fscanf(dict_file, "%s", dictionary[dict_size]) != EOF) {
        dict_size++;
    }
    fclose(dict_file);
    printf("Enter number of words (max %d): ", MAX);
    if (scanf("%d", &total_words) != 1) return 1;
    WordItem words[MAX];
    for ( i = 0; i < total_words; i++) {
        printf("Word %d: ", i + 1);
        scanf("%s", words[i].word);
        words[i].index = i;
    }
    pthread_mutex_init(&mutex, NULL);
    pthread_cond_init(&full, NULL);
    pthread_cond_init(&empty, NULL);
    for ( i = 0; i < NUM_THREADS; i++)
        pthread_create(&threads[i], NULL, spell_check, NULL);
    for ( i = 0; i < total_words; i++) {
        pthread_mutex_lock(&mutex);
        while (count == BUFFER_SIZE) pthread_cond_wait(&empty, &mutex);
        buffer[in] = words[i];
        in = (in + 1) % BUFFER_SIZE;
        count++;
        pthread_cond_signal(&full);
        pthread_mutex_unlock(&mutex);
    }
    pthread_mutex_lock(&mutex);
    done = 1;
    pthread_cond_broadcast(&full);
    pthread_mutex_unlock(&mutex);
    for ( i = 0; i < NUM_THREADS; i++)
        pthread_join(threads[i], NULL);
    printf("\nSpell Check Results:\n");
    for ( i = 0; i < total_words; i++)
        printf("%s\n", result_buffer[i]);
    pthread_mutex_destroy(&mutex);
    pthread_cond_destroy(&full);
    pthread_cond_destroy(&empty);

    return 0;
}
